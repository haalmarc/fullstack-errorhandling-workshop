{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": { "@workshop/*": ["./start/frontend/*"] }
  },
  "include": ["shared/frontend", "start/frontend", "losningsforslag/frontend", "tests", "vite.config.ts", "playwright.config.ts"]
}
